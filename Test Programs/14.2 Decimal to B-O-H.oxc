air int decToBinary(int n){
    int binary = 0~
    int place = 1~

    cycle(n > 0){
        int mod = n % 2~
        binary = binary + mod * place~

        place = place * 10~
        n /= 2~
    }
    gasp binary~
}

air int decToOctal(int n){
    int oct = 0~
    int place = 1~

    cycle(n > 0){
        int mod = n % 8~
        oct = oct + mod * place~

        place = place * 10~
        n /= 8~
    }

    gasp oct~
}

air string decToHex(int n){
    string hex = ""~

    cycle(n > 0){

        int mod = n % 16~
        string digit~

        stream(mod){
            case 10: digit = "A"~ resist~
            case 11: digit = "B"~ resist~
            case 12: digit = "C"~ resist~
            case 13: digit = "D"~ resist~
            case 14: digit = "E"~ resist~
            case 15: digit = "F"~ resist~
            diffuse: digit = "@{mod}"~ resist~
        }

        hex = digit & hex~
        n /= 16~

    }
    gasp hex~
}

atmosphere(){

    int num~

    exhale("Enter decimal number: ")~
    inhale(num)~

    int bin = decToBinary(num)~
    int oct = decToOctal(num)~
    string hex = decToHex(num)~

    exhale("\nBinary: @{bin}")~
    exhale("\nOctal: @{oct}")~
    exhale("\nHexadecimal: @{hex}")~

}