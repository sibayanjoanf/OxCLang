atmosphere(){
    int row, col, product~

    exhale("Enter rows: ")~
    inhale(row)~

    exhale("Enter columns: ")~
    inhale(col)~

    echo(int i = 1~ i <= row~ i++~){
        echo(int j = 1~ j <= col~ j++~){
            product = j * i~
            exhale("@{j} x @{i} = @{product}\t")~
        }
        exhale("\n")~
    }
}