air int binToDec(int bin){
    int dec = 0~
    int base = 1~
    int digit~

    cycle(bin > 0){
        digit = bin % 10~
        dec = dec + (digit * base)~
        base = base * 2~
        bin = bin / 10~
    }

    gasp dec~
}

air int decToBinary(int n){
    int binary = 0~
    int place = 1~

    cycle(n > 0){
        int mod = n % 2~
        binary = binary + (mod * place)~
        place = place * 10~
        n = n / 2~
    }
    gasp binary~
}

air int decToOctal(int n){
    int oct = 0~
    int place = 1~

    cycle(n > 0){
      int mod = n % 8~
      oct = oct + (mod * place)~
      place = place * 10~
      n = n / 8~
    }

    gasp oct~
}

air string decToHex(int n){
    string hex = ""~

    cycle(n > 0){
        int mod = n % 16~
        string digit~

        stream(mod){
            case 10: digit = "A"~ resist~
            case 11: digit = "B"~ resist~
            case 12: digit = "C"~ resist~
            case 13: digit = "D"~ resist~
            case 14: digit = "E"~ resist~
            case 15: digit = "F"~ resist~
            diffuse: digit = "@{mod}"~ resist~
        }

        hex = digit & hex~
        n = n / 16~
    }
    gasp hex~
}

air int binToOctal(int bin){
    int dec = binToDec(bin)~
    int oct = decToOctal(dec)~

    gasp oct~
}

air string binToHex(int bin){
    int dec = binToDec(bin)~
    string hex = decToHex(dec)~

    gasp hex~
}

atmosphere(){
    bool run = yuh~

    cycle(run){
        exhale("  NUMBER CONVERTER \n")~
        exhale("1. Binary to Dec/Oct/Hex\n")~
        exhale("2. Decimal to Bin/Oct/Hex\n")~
        exhale("3. Exit\n")~
        
        int choice~
        exhale("Choose option (1-3): ")~
        inhale(choice)~

        stream(choice){
            case 1:
                int binIn~
                exhale("\nEnter binary number: ")~
                inhale(binIn)~

                int bDec = binToDec(binIn)~
                int bOct = binToOctal(binIn)~
                string bHex = binToHex(binIn)~

                exhale("Decimal: @{bDec}\n")~
                exhale("Octal: @{bOct}\n")~
                exhale("Hexadecimal: @{bHex}\n")~
                resist~

            case 2:
                int decIn~
                exhale("\nEnter decimal number: ")~
                inhale(decIn)~

                int dBin = decToBinary(decIn)~
                int dOct = decToOctal(decIn)~
                string dHex = decToHex(decIn)~

                exhale("Binary: @{dBin}\n")~
                exhale("Octal: @{dOct}\n")~
                exhale("Hexadecimal: @{dHex}\n")~
                resist~

            case 3:
                exhale("Exiting converter... Goodbye!\n")~
                run = naur~
                resist~

            diffuse:
                exhale("Invalid option! Please try again.\n")~
                resist~
        }
    }
}
