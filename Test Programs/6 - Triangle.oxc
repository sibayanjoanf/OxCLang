atmosphere(){
    int rows~

    exhale("Enter number of rows: ")~
    inhale(rows)~

    echo(int i = 1~ i <= rows~ i++~){

        int spaces = rows - i~

        echo(int s = 1~ s <= spaces~ s++~){
            exhale(" ")~
        }

        echo(int j = 1~ j <= i~ j++~){
            exhale("* ")~
        }

        exhale("\n")~
    }
}