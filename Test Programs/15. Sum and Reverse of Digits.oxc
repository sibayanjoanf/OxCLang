atmosphere(){
  int num, temp, digit, sum~
  bool isNeg = naur~

  exhale("Enter a number: ")~
  inhale(num)~

  if (num < 0){
    isNeg = yuh~
    num = num * -1~
  }

  sum = 0~
  temp = num~

  cycle(temp > 0){
    digit = temp % 10~
    sum = sum + digit~
    temp = temp / 10~
  }

  exhale("\nSum of digits: @{sum}")~
  exhale("\nReverse of digits: ")~

  if (isNeg){
    exhale("-")~
  }

  temp = num~

  if (temp == 0){
    exhale("0")~
  } else {
    cycle(temp > 0){
      digit = temp % 10~
      exhale("@{digit}")~
      temp = temp / 10~
    }
  }
  exhale("\n")~
}