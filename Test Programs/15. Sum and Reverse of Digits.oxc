atmosphere(){
  int num, num2, sum, digit~
  exhale("Enter a number: ")~
  inhale(num)~
  
  num2 = num~
  cycle(num != 0){
    digit = num % 10~
    sum += digit~
    num /= 10~
  }

  string str = toString(num2)~
  string rev = ""~
  int i~
  
  i = horizon(str) - 1~

  cycle(i >= 0){
    rev = rev & toString(str[i])~
    i--~
  }

  exhale("\nSum of digits = @{sum}")~
  exhale("\nReverse: @{rev}")~
}